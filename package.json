{
  "name": "redemc-prueba-desarrollo",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "composer install --no-interaction",
    "db:setup": "php database/setup.php",
    "dev": "php -S localhost:8000 -t public public/index.php",
    "test": "npm run test:php && npm run test:js",
    "test:php": "php vendor/bin/phpunit",
    "test:js": "vitest run --environment jsdom --passWithNoTests"
  },
  "devDependencies": {
    "jquery": "^4.1.0",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.2"
  }
}
