# Copiá este archivo como .env y reemplazá los valores YOUR_* (el .env nunca se commitea).
# En Railway estas variables se configuran en el servicio de la app, no con este archivo.
DB_HOST=YOUR_DB_HOST
DB_PORT=YOUR_DB_PORT
DB_NAME=redemc_dev
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# Base exclusiva para los tests: debe terminar en _test porque se vacía en cada test.
DB_TEST_NAME=redemc_test
