{
    "name": "devmeupscotty/redemc-prueba-desarrollo",
    "description": "Registro de personas con validación, guardado por AJAX en MySQL y listado paginado.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
